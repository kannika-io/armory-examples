#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/scripts/env.sh"
__env_load

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Configuration
CLUSTER_NAME="${CLUSTER_NAME:-kannika-kind}"

print_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

run_hook() {
    local hook_name="$1"
    if [ -n "${HOOKS_DIR}" ] && [ -f "${HOOKS_DIR}/${hook_name}.sh" ]; then
        print_info "Running ${hook_name} hook..."
        source "${HOOKS_DIR}/${hook_name}.sh"
    fi
}

print_info "Tearing down Kannika Armory environment..."

# Delete Kind cluster
if kind get clusters 2>/dev/null | grep -q "^${CLUSTER_NAME}$"; then
    print_info "Deleting Kind cluster: ${CLUSTER_NAME}..."
    kind delete cluster --name "${CLUSTER_NAME}"
    print_info "Kind cluster deleted."
else
    print_warning "Kind cluster '${CLUSTER_NAME}' not found. Skipping."
fi

# Run tutorial teardown hook
TUTORIALS_DIR="${SCRIPT_DIR}/tutorials"
if [ -n "$1" ] && [ -d "${TUTORIALS_DIR}/$1" ]; then
    export TUTORIAL_DIR="${TUTORIALS_DIR}/$1"
    export HOOKS_DIR="${TUTORIAL_DIR}"
    run_hook "teardown"
fi

# Stop Kafka
print_info "Stopping Kafka clusters..."
docker-compose -f "$(__env_repo_root)/docker-compose.yml" down -v 2>/dev/null || true
print_info "Kafka clusters stopped."
print_info "Teardown complete."
